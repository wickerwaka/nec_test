// THE SAME construct keyed on a published OUTPUT ENABLE instead of on the net.
module top(input clk, input a_oe, input [19:0] a_val,
           input b_oe, input [15:0] b_val, output [19:0] eff);
tri [19:0] net;
assign net        = a_oe ? a_val : 20'hzzzzz;
assign net[15:0]  = b_oe ? b_val : 16'hzzzz;
wire [19:0] drv = {20{a_oe}} | {4'b0, {16{b_oe}}};
reg  [19:0] hold;
genvar i;
generate for (i=0;i<20;i=i+1) begin : g_ad_ret
    assign eff[i] = drv[i] ? net[i] : hold[i];
end endgenerate
always @(posedge clk)
    for (int k=0;k<20;k=k+1) if (drv[k]) hold[k] <= net[k];
endmodule
