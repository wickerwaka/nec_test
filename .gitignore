**/.DS_Store
__pycache__/
largemode_synth.hex
sw/testdata/chipcache/

# Fuzz campaign runtime state: the loose per-seed captures (242M+) and the
# heartbeat beacon are working data - the curated regression corpus lives in
# tests/v30/fuzz_bank/. Specific evidence captures are committed explicitly.
sw/testdata/campaigns/*/captures/
sw/testdata/campaigns/*/heartbeat.json
tests/v30/*/heartbeat.json

# BIU black-box campaign ledgers are local working data.  The frozen oracle
# JSON files at the root of this directory are versioned explicitly.
sw/testdata/biu_blackbox/*/

# Top-level experiment transcripts and per-case result dumps are local working
# data.  Evidence cited by repository notes is versioned explicitly.
sw/*.log
sw/*.stdout
sw/case*.json
sw/exp_race_characterize.json
sw/class5_lbcal.json
